APP_PORT=8080

POSTGRES_DB=uber_clone
POSTGRES_USER=uber_clone
POSTGRES_PASSWORD=uber_clone_local

# Application-owned identity boundary. Only adapters depend on the concrete provider.
AUTH_PROVIDER=kratos
AUTH_IDENTITY_SOURCE=primary-identity-v1

# Ory Kratos remains internal to the deployment network.
ORY_KRATOS_DB=ory_kratos
KRATOS_PUBLIC_URL=http://kratos:4433
KRATOS_ADMIN_URL=http://kratos:4434

# Ory Kratos session lifecycle. Use valid Go-style durations accepted by Kratos,
# for example: 24h, 168h, or 336h. These values override Kratos config defaults.
SESSION_LIFESPAN=336h
SESSION_EARLIEST_POSSIBLE_EXTEND=24h

# Optional internal Driver onboarding reviewer. Admin routes are not registered unless
# both values are configured. Use a strong non-example password locally and require
# HTTPS before exposing this temporary MVP reviewer outside a trusted development host.
ADMIN_REVIEW_USERNAME=
ADMIN_REVIEW_PASSWORD=
# Public origin when the admin reviewer runs behind an HTTPS reverse proxy.
ADMIN_REVIEW_ORIGIN=

# Pilot-only values are supplied externally; the pilot Compose file has no fallbacks.
# KRATOS_PUBLIC_URL=https://identity.example.com/
# KRATOS_BROWSER_RETURN_URL=https://app.example.com/
# KRATOS_SMTP_CONNECTION_URI=smtps://user:password@smtp.example.com:465/
# KRATOS_SMTP_FROM_ADDRESS=no-reply@example.com
# KRATOS_SMTP_FROM_NAME=Uber Clone


# Google Maps Platform web-service key used only by the Go backend for Places
# Autocomplete (New), Place Details (New), Geocoding v4 and later Routes calls.
# Restrict this key to the required server APIs; never ship it in Flutter.
GOOGLE_MAPS_SERVER_API_KEY=
# Per-user application guard for location-search endpoint calls.
LOCATION_SEARCH_REQUESTS_PER_MINUTE=60

# Enable only after approved service tariffs and the compatible Rider client are ready.
SUGGESTED_FARES_ENABLED=false

# LOCAL DEVELOPMENT ONLY — see docs/phone-sms-twilio-smoke-test.md.
# SMS issuance remains disabled unless deliberately opted in. Restrict actual
# recipient numbers; never commit a live phone number or Twilio credentials.
PHONE_SMS_ISSUANCE_ENABLED=false
PHONE_SMS_WORKER_ENABLED=false
PHONE_REGISTRATION_ENABLED=false
PHONE_SMS_TEST_ALLOWED_NUMBERS=
PHONE_OTP_HMAC_SECRET=
PHONE_SMS_DISPATCH_ENCRYPTION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Configure exactly one of the following when the SMS worker is enabled:
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
