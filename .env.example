APP_PORT=8080

POSTGRES_DB=uber_clone
POSTGRES_USER=uber_clone
POSTGRES_PASSWORD=uber_clone_local

# Application-owned identity boundary. Only adapters depend on the concrete provider.
AUTH_PROVIDER=kratos
AUTH_IDENTITY_SOURCE=primary-identity-v1

# Ory Kratos remains internal to the deployment network.
ORY_KRATOS_DB=ory_kratos
KRATOS_PUBLIC_URL=http://kratos:4433
KRATOS_ADMIN_URL=http://kratos:4434

# Ory Kratos session lifecycle. Use valid Go-style durations accepted by Kratos,
# for example: 24h, 168h, or 336h. These values override Kratos config defaults.
SESSION_LIFESPAN=336h
SESSION_EARLIEST_POSSIBLE_EXTEND=24h

# Optional internal Driver onboarding reviewer. Admin routes are not registered unless
# both values are configured. Use a strong non-example password locally and require
# HTTPS before exposing this temporary MVP reviewer outside a trusted development host.
ADMIN_REVIEW_USERNAME=
ADMIN_REVIEW_PASSWORD=
# Public origin when the admin reviewer runs behind an HTTPS reverse proxy.
ADMIN_REVIEW_ORIGIN=
